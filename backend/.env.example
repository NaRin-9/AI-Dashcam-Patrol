# พอร์ตของ backend (frontend proxy /api มาที่ 8000)
PORT=8000
# origin ของ frontend สำหรับ CORS
ALLOWED_ORIGIN=http://localhost:5173
# จำกัดให้ Go รับเฉพาะการเชื่อมต่อในเครื่องตอนทดสอบ
# HOST=127.0.0.1
# PostgreSQL สำหรับระบบล็อกอิน
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=dashcam_patrol
DB_SSLMODE=disable
# ตั้ง JWT_SECRET จากค่าสุ่มอย่างน้อย 32 ไบต์
JWT_SECRET=
# ตั้งครบทั้งสามค่าหากต้องสร้าง Superadmin คนแรก
# SUPERADMIN_USERNAME=
# SUPERADMIN_EMAIL=
# SUPERADMIN_PASSWORD=
# ตั้งเมื่อต้องการเปลี่ยนรหัสผ่านเริ่มต้นของบัญชีใหม่ที่สร้างด้วย -seed-demo-users
# DEMO_USERS_PASSWORD=
# ตั้งค่านี้เพื่อให้ Go เสิร์ฟเว็บที่ build แล้ว
# FRONTEND_DIR=../frontend/dist
# โฟลเดอร์เก็บวิดีโออัปโหลด (ค่าเริ่มต้น data/videos ใน backend)
# VIDEO_UPLOAD_DIR=
